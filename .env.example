# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# This workflow deliberately uses only key-free data sources, so NO secrets are
# required for a normal run. The variables below are optional.

# Open Library asks API consumers to send a descriptive User-Agent with a contact
# address, otherwise requests may be rate-limited or blocked.
# See https://openlibrary.org/dev/docs/restful_api
OPENLIBRARY_USER_AGENT="learning-path-workflow/1.0 (you@example.com)"

# Absolute path to this repository. Only needed if your Claude Code build does not
# launch MCP servers with the project root as the working directory (see README).
# WORKFLOW_HOME=/absolute/path/to/workflow-project
